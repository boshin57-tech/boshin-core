<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TOBMATE Blockchain</title>

<style>
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#08111d;
  color:#fff;
}
header{
  padding:20px;
  background:#0d1b2a;
  border-bottom:1px solid #23364a;
}
main{
  max-width:1000px;
  margin:auto;
  padding:30px 20px;
}
.card{
  background:#102033;
  border:1px solid #20364c;
  border-radius:12px;
  padding:20px;
  margin-bottom:18px;
}
button{
  padding:12px 18px;
  margin:5px;
  border:0;
  border-radius:8px;
  cursor:pointer;
}
.primary{
  background:#27c7aa;
}
.secondary{
  background:#22354b;
  color:white;
}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(130px,1fr));
  gap:10px;
}
.item{
  padding:15px;
  background:#0b1726;
  border-radius:8px;
  text-align:center;
}
</style>
</head>

<body>

<header>
  <strong>TOBMATE Blockchain</strong>
</header>

<main>

<div class="card">
  <h2>Wallet</h2>
  <p>Status: <b>Not Created</b></p>
<div style="margin:15px 0;">
    <input id="tmidUser"
      placeholder="TMID ID"
      style="padding:10px;width:180px;margin:5px;">

    <input id="tmidPassword"
      type="password"
      placeholder="Password"
      style="padding:10px;width:180px;margin:5px;">

    <button class="secondary"
      onclick="bindTobmateWallet()">
      Bind Wallet
    </button>
  </div>

  <div id="bindingStatus"
    style="margin:10px 5px;color:#8fb3d9;">
    TMID ↔ Wallet: Not Bound
  </div>
  <button
    id="registerPasskeyBtn"
    class="primary"
    onclick="registerTobmatePasskey()">
    Register Passkey
  </button>

  <button class="primary" onclick="createTobmateWallet()">
    Create Wallet
  </button>

  <button class="secondary"
    onclick="alert('Existing Sui wallet connection will be enabled next.')">
    Connect Existing Wallet
  </button>
</div>

<div class="card">
  <h2>Assets</h2>

  <div class="grid">
    <div class="item">SUI</div>
    <div class="item">GOLDPEG</div>
    <div class="item">Gold NFT</div>
  </div>
</div>

<div class="card">
  <h2>Transaction Security</h2>

  <button
    id="testTxAuthBtn"
    class="primary"
    onclick="testTransactionAuthorization()">
    Test Passkey Transaction Approval
  </button>

  <div id="txAuthStatus"
    style="margin-top:10px;color:#8fb3d9;">
    Status: Not Authorized
  </div>
</div>

<div class="card">
  <h2>Functions</h2>

  <div class="grid">
    <div class="item">Send</div>
    <div class="item">Receive</div>
    <div class="item">Swap</div>
    <div class="item">Marketplace</div>
    <div class="item">Lending</div>
    <div class="item">Staking</div>
    <div class="item">Transactions</div>
  </div>
</div>

</main>
<script>
document.addEventListener('DOMContentLoaded', function () {

  document.querySelectorAll('.card').forEach(function(card) {

    var title = card.querySelector('h2');

    if (!title || title.textContent.trim() !== 'Functions') {
      return;
    }

    card.querySelectorAll('.item').forEach(function(item) {

      item.style.cursor = 'pointer';

      item.addEventListener('click', function () {

        var name = item.textContent.trim();

        alert(
          name +
          ' 기능은 다음 Blockchain 연결 단계에서 활성화됩니다.'
        );

      });

    });

  });

});
document.querySelectorAll('.card').forEach(function(card){

  var title = card.querySelector('h2');

  if (!title || title.textContent.trim() !== 'Assets') return;

  card.querySelectorAll('.item').forEach(function(item){

    item.style.cursor = 'pointer';

    item.addEventListener('click', function(){

      alert(
        item.textContent.trim() +
        ' 자산 상세 기능은 Wallet 연결 후 활성화됩니다.'
      );

    });

  });

});
</script>
<script src="/blockchain/wallet-client.js?v=1"></script>
<script>
async function createTobmateWallet() {
  try {
    const wallet = await window.TobmateWallet.create();

    document.querySelector('.card p').innerHTML =
      'Status: <b>Wallet Ready</b><br><br>' +
      'Sui Address:<br>' +
      wallet.address;

    alert(
      'TOBMATE Wallet Created\n\nSui Address:\n' +
      wallet.address
    );

  } catch (e) {
    console.error(e);
    alert('Wallet creation failed: ' + e.message);
  }
}async function bindTobmateWallet() {
  const userId =
    document.getElementById('tmidUser').value.trim();

  const password =
    document.getElementById('tmidPassword').value;

  const status =
    document.getElementById('bindingStatus');

  try {
    if (!userId || !password) {
      throw new Error('TMID ID와 Password를 입력하세요.');
    }

    status.textContent = 'TMID 인증 중...';

    // 1. Blockchain 전용 로그인
    const loginRes = await fetch(
      '/blockchain-api/auth/login',
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          user_id: userId,
          password: password
        })
      }
    );

    const login = await loginRes.json();

    if (!login.ok || !login.token) {
      throw new Error('TMID 인증 실패');
    }

    sessionStorage.setItem(
      'tobmate_blockchain_token',
      login.token
    );

    // Password는 즉시 화면에서 제거
    document.getElementById('tmidPassword').value = '';

    status.textContent = 'Wallet Challenge 생성 중...';

    // 2. 일회용 Challenge 발급
    const challengeRes = await fetch(
      '/blockchain-api/wallet/challenge',
      {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + login.token
        }
      }
    );

    const challenge = await challengeRes.json();

    if (!challenge.ok || !challenge.message) {
      throw new Error('Challenge 발급 실패');
    }

    // 3. 현재 Sui Wallet 확인
    const address =
      await window.TobmateWallet.getAddress();

    if (!address) {
      throw new Error(
        '먼저 Create Wallet을 실행하세요.'
      );
    }

    status.textContent = 'Sui Wallet 서명 중...';

    // 4. Challenge에 Sui 지갑 서명
    const signed =
      await window.TobmateWallet.signMessage(
        challenge.message
      );

    // 5. 서버에서 서명 검증 + Binding
    const bindRes = await fetch(
      '/blockchain-api/wallet/bind',
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + login.token
        },
        body: JSON.stringify({
          address: address,
          signature: signed.signature
        })
      }
    );

    const bound = await bindRes.json();

    if (!bound.ok) {
      throw new Error(
        bound.error || 'Wallet Binding 실패'
      );
    }

    status.innerHTML =
      'TMID ↔ Wallet: <b>BOUND</b><br>' +
      'TMID: ' + bound.user_id + '<br>' +
      'Sui: ' + bound.address;

  } catch (e) {
    console.error(e);

    status.textContent =
      'Binding Failed: ' + e.message;
  }
}
</script>

<script>
function b64urlToBytes(value) {
  var base64 = value.replace(/-/g, '+').replace(/_/g, '/');
  while (base64.length % 4) base64 += '=';

  var binary = atob(base64);
  var bytes = new Uint8Array(binary.length);

  for (var i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

function bytesToB64url(value) {
  var bytes = new Uint8Array(value);
  var binary = '';

  for (var i = 0; i < bytes.length; i++) {
    binary += String.fromCharCode(bytes[i]);
  }

  return btoa(binary)
    .replace(/\+/g, '-')
    .replace(/\//g, '_')
    .replace(/=+$/g, '');
}

async function registerTobmatePasskey() {
  try {
    var token =
      sessionStorage.getItem('tobmate_blockchain_token') ||
      localStorage.getItem('tobmate_blockchain_token');

    if (!token) {
      alert('Blockchain login token이 없습니다. 먼저 로그인해 주세요.');
      return;
    }

    if (!window.PublicKeyCredential || !navigator.credentials) {
      alert('이 브라우저는 Passkey/WebAuthn을 지원하지 않습니다.');
      return;
    }

    var optionResponse = await fetch(
      '/blockchain-api/passkey/register/options',
      {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type': 'application/json'
        },
        body: '{}'
      }
    );

    var optionResult = await optionResponse.json();

    if (!optionResponse.ok || !optionResult.ok) {
      throw new Error(
        optionResult.error || 'PASSKEY_OPTIONS_FAILED'
      );
    }

    var publicKey = optionResult.options;

    publicKey.challenge =
      b64urlToBytes(publicKey.challenge);

    publicKey.user.id =
      b64urlToBytes(publicKey.user.id);

    if (publicKey.excludeCredentials) {
      publicKey.excludeCredentials =
        publicKey.excludeCredentials.map(function(c) {
          return Object.assign({}, c, {
            id: b64urlToBytes(c.id)
          });
        });
    }

    var credential = await navigator.credentials.create({
      publicKey: publicKey
    });

    if (!credential) {
      throw new Error('PASSKEY_CREATION_CANCELLED');
    }

    var payload = {
      id: credential.id,
      rawId: bytesToB64url(credential.rawId),
      type: credential.type,
      response: {
        clientDataJSON:
          bytesToB64url(
            credential.response.clientDataJSON
          ),
        attestationObject:
          bytesToB64url(
            credential.response.attestationObject
          ),
        transports:
          credential.response.getTransports
            ? credential.response.getTransports()
            : []
      },
      clientExtensionResults:
        credential.getClientExtensionResults()
    };

    var verifyResponse = await fetch(
      '/blockchain-api/passkey/register/verify',
      {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(payload)
      }
    );

    var verifyResult = await verifyResponse.json();

    if (!verifyResponse.ok || !verifyResult.ok) {
      throw new Error(
        verifyResult.error || 'PASSKEY_VERIFY_FAILED'
      );
    }

    alert(
      'TOBMATE Passkey 등록 완료\n\n' +
      'TMID 계정에 이 기기의 Passkey가 등록되었습니다.'
    );

  } catch (err) {
    console.error('[PASSKEY_REGISTER]', err);

    if (err.name === 'NotAllowedError') {
      alert('Passkey 등록이 취소되었거나 인증 시간이 초과되었습니다.');
      return;
    }

    alert('Passkey 등록 실패: ' + err.message);
  }
}
</script>


<script>
async function testTransactionAuthorization() {
  try {
    const status =
      document.getElementById('txAuthStatus');

    const token =
      sessionStorage.getItem('tobmate_blockchain_token');

    if (!token) {
      throw new Error(
        'Blockchain 인증이 만료되었습니다. 먼저 Bind Wallet을 다시 실행하세요.'
      );
    }

    status.textContent =
      'Status: Transaction Challenge 생성 중...';

    const r = await fetch(
      '/blockchain-api/transaction/challenge',
      {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          action: 'TEST_TRANSACTION',
          payload: {
            network: 'sui',
            purpose: 'passkey-authorization-test'
          }
        })
      }
    );

    const data = await r.json();

    if (!r.ok || !data.ok) {
      throw new Error(
        data.error || 'TX_CHALLENGE_FAILED'
      );
    }

    const publicKey = data.options;

    publicKey.challenge =
      b64urlToBytes(publicKey.challenge);

    if (publicKey.allowCredentials) {
      publicKey.allowCredentials =
        publicKey.allowCredentials.map(function(c) {
          return Object.assign({}, c, {
            id: b64urlToBytes(c.id)
          });
        });
    }

    status.textContent =
      'Status: Passkey 승인 대기 중...';

    const assertion =
      await navigator.credentials.get({
        publicKey
      });

    if (!assertion) {
      throw new Error(
        'PASSKEY_AUTHENTICATION_CANCELLED'
      );
    }

    const payload = {
      id: assertion.id,
      rawId: bytesToB64url(assertion.rawId),
      type: assertion.type,
      response: {
        authenticatorData:
          bytesToB64url(
            assertion.response.authenticatorData
          ),
        clientDataJSON:
          bytesToB64url(
            assertion.response.clientDataJSON
          ),
        signature:
          bytesToB64url(
            assertion.response.signature
          ),
        userHandle:
          assertion.response.userHandle
            ? bytesToB64url(
                assertion.response.userHandle
              )
            : null
      },
      clientExtensionResults:
        assertion.getClientExtensionResults()
    };

    status.textContent =
      'Status: Passkey 검증 중...';

    const authRes = await fetch(
      '/blockchain-api/transaction/authorize',
      {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          tx_id: data.tx_id,
          response: payload
        })
      }
    );

    const auth = await authRes.json();

    if (!authRes.ok || !auth.ok) {
      throw new Error(
        auth.error || 'TX_AUTHORIZE_FAILED'
      );
    }

    status.textContent =
      'Status: AUTHORIZED';

  } catch (err) {
    console.error('[TX_AUTH_TEST]', err);

    document.getElementById(
      'txAuthStatus'
    ).textContent =
      'Status: Failed - ' + err.message;
  }
}
</script>
