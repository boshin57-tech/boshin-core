import {
  simulateTransaction,
} from './blockchain-transaction.mjs';

try {
  console.log(
    '===== PHASE 3A TRANSACTION SIMULATION =====',
  );

  const result =
    await simulateTransaction({
      kind: 'self-transfer',
      amountMist: '1',
      gasBudget: '10000000',
    });

  console.log(
    JSON.stringify(result, null, 2),
  );

  if (!result.ok) {
    process.exitCode = 1;
  }
} catch (error) {
  console.error(
    'PHASE 3A SIMULATION FAILED',
  );

  console.error(
    error?.stack ?? error,
  );

  process.exitCode = 1;
}
